generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  guest
  client
  freelancer
  agency
  admin
  support
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  passwordHash     String   @default("demo")
  avatar           String   @db.Text
  role             UserRole
  isVerified       Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  timezone         String   @default("UTC")
  connects         Int      @default(0)
  walletBalance    Decimal  @default(0) @db.Decimal(12, 2)
  escrowBalance    Decimal  @default(0) @db.Decimal(12, 2)
  rating           Decimal  @default(0) @db.Decimal(3, 2)
  reviewsCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  freelancerProfile     FreelancerProfile?
  clientProfile         ClientProfile?
  ownedAgencies         AgencyProfile[]
  jobsPosted            Job[]                      @relation("ClientJobs")
  proposals             Proposal[]
  contractsAsClient     Contract[]                 @relation("ContractClient")
  contractsAsFreelancer Contract[]                 @relation("ContractFreelancer")
  sentMessages          Message[]
  transactions          WalletTransaction[]
  disputesAsClient      Dispute[]                  @relation("DisputeClient")
  disputesAsFreelancer  Dispute[]                  @relation("DisputeFreelancer")
  notifications         Notification[]
  activityLogs          ActivityLog[]
  conversationLinks     ConversationParticipant[]
}

model FreelancerProfile {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String  @db.Text
  title           String
  overview        String  @db.Text
  hourlyRate      Decimal @db.Decimal(10, 2)
  fixedPreference String
  skills          Json
  availability    String
  languages       Json
  location        String
  address         String
  totalEarned     Decimal @default(0) @db.Decimal(12, 2)
  jobSuccessScore Int     @default(0)
  videoIntroUrl   String? @db.Text
  profileStrength Int     @default(0)
  experiences     Json
  education       Json
  certifications  Json
  portfolio       Json
}

model ClientProfile {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  industry           String
  companySize        String
  description        String  @db.Text
  website            String
  location           String
  paymentVerified    Boolean @default(false)
  totalSpent         Decimal @default(0) @db.Decimal(12, 2)
  openJobsCount      Int     @default(0)
  completedJobsCount Int     @default(0)
  avgRating          Decimal @default(0) @db.Decimal(3, 2)
}

model AgencyProfile {
  id             String  @id
  ownerId        String
  owner          User    @relation(fields: [ownerId], references: [id])
  name           String
  logo           String  @db.Text
  description    String  @db.Text
  membersCount   Int     @default(0)
  freelancerIds  Json
  totalEarnings  Decimal @default(0) @db.Decimal(12, 2)
  commissionRate Decimal @default(10) @db.Decimal(5, 2)
}

model Job {
  id                    String   @id
  clientId              String
  client                User     @relation("ClientJobs", fields: [clientId], references: [id])
  clientName            String
  clientLocation        String
  clientRating          Decimal  @db.Decimal(3, 2)
  clientPaymentVerified Boolean
  clientTotalSpent      Decimal  @db.Decimal(12, 2)
  title                 String
  description           String   @db.LongText
  jobType               String
  category              String
  subcategory           String
  skills                Json
  budget                Decimal  @db.Decimal(12, 2)
  hourlyMin             Decimal? @db.Decimal(10, 2)
  hourlyMax             Decimal? @db.Decimal(10, 2)
  experienceLevel       String
  duration              String
  projectLength         String
  visibility            String   @default("public")
  isFeatured            Boolean  @default(false)
  isUrgent              Boolean  @default(false)
  status                String   @default("open")
  attachments           Json
  screeningQuestions    Json
  createdAt             DateTime @default(now())
  proposalsCount        Int      @default(0)
  hiresCount            Int      @default(0)
  proposals             Proposal[]
  contracts             Contract[]

  @@index([status, createdAt])
  @@index([clientId])
}

model Proposal {
  id                String   @id
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId      String
  freelancer        User     @relation(fields: [freelancerId], references: [id])
  freelancerName    String
  freelancerAvatar  String   @db.Text
  freelancerTitle   String
  freelancerRating  Decimal  @db.Decimal(3, 2)
  freelancerJSS     Int
  coverLetter       String   @db.LongText
  bidAmount         Decimal  @db.Decimal(12, 2)
  estimatedDuration String
  boostCredits      Int      @default(0)
  milestones        Json
  answers           Json
  status            String   @default("submitted")
  createdAt         DateTime @default(now())

  @@index([jobId])
  @@index([freelancerId])
}

model Contract {
  id             String    @id
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id])
  jobTitle       String
  clientId       String
  client         User      @relation("ContractClient", fields: [clientId], references: [id])
  clientName     String
  freelancerId   String
  freelancer     User      @relation("ContractFreelancer", fields: [freelancerId], references: [id])
  freelancerName String
  contractType   String
  rate           Decimal   @db.Decimal(12, 2)
  totalBudget    Decimal   @db.Decimal(12, 2)
  escrowBalance  Decimal   @db.Decimal(12, 2)
  totalPaid      Decimal   @db.Decimal(12, 2)
  status         String
  startDate      DateTime
  endDate        DateTime?
  milestones     Milestone[]
  timesheets     TimesheetEntry[]
}

model Milestone {
  id                   String   @id
  contractId           String
  contract             Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title                String
  amount               Decimal  @db.Decimal(12, 2)
  dueDate              String
  status               String
  submissionNote       String?  @db.Text
  submissionAttachment String?  @db.Text
}

model TimesheetEntry {
  id            String   @id
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  date          String
  hours         Decimal  @db.Decimal(6, 2)
  activityScore Int
  notes         String   @db.Text
  screenshotUrl String?  @db.Text
  isManual      Boolean  @default(false)
}

model Conversation {
  id                   String                     @id
  jobTitle             String?
  lastMessage          String?                    @db.Text
  lastMessageTimestamp DateTime?
  participants         ConversationParticipant[]
  messages             Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  name           String
  avatar         String       @db.Text
  unreadCount    Int          @default(0)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  senderName     String
  senderAvatar   String       @db.Text
  text           String       @db.Text
  attachments    Json?
  voiceNoteUrl   String?      @db.Text
  isRead         Boolean      @default(false)
  timestamp      DateTime     @default(now())
}

model WalletTransaction {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String
  amount        Decimal  @db.Decimal(12, 2)
  status        String
  paymentMethod String
  description   String   @db.Text
  referenceId   String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model Dispute {
  id                      String   @id
  contractId              String
  contractTitle           String
  clientId                String
  client                  User     @relation("DisputeClient", fields: [clientId], references: [id])
  clientName              String
  freelancerId            String
  freelancer              User     @relation("DisputeFreelancer", fields: [freelancerId], references: [id])
  freelancerName          String
  disputedAmount          Decimal  @db.Decimal(12, 2)
  reason                  String   @db.Text
  clientClaim             String   @db.Text
  freelancerResponse      String?  @db.Text
  status                  String
  adminDecision           String?  @db.Text
  refundClientAmount      Decimal? @db.Decimal(12, 2)
  releaseFreelancerAmount Decimal? @db.Decimal(12, 2)
  createdAt               DateTime @default(now())
}

model SkillTest {
  id               String @id
  title            String
  category         String
  timeLimitMinutes Int
  questionsCount   Int
  passingScore     Int
  questions        Json
}

model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String?

  @@index([userId, createdAt])
}

model ActivityLog {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  userName  String
  userRole  String
  action    String
  ipAddress String
  userAgent String   @db.Text
  createdAt DateTime @default(now())
}
